.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.swp
*.tmp

# Office creates these temporary lock files alongside user-owned spreadsheets.
*.xlsx
~$*.xlsx

# Network-derived and machine-derived data: rebuilt automatically.
capcut_local_data/cache/
capcut_local_data/features/
capcut_local_data/media/
capcut_local_data/categories/*/background.json
capcut_local_data/*.log

# Historical safety snapshots are retained locally but are not the current state.
capcut_local_data/**/*.backup-*.json
capcut_local_data/**/*.before-*.json

# Generated distribution packages duplicate the canonical source tree.
outputs/
CapCut作者审核_分享版/
capcut_local_data/categories/*/before-v3-migration-*/
capcut_local_data/v2-superseded-*/
capcut_local_data/server.pid
capcut_local_data/explore_index_*.json
capcut_local_data/explore_counts_*.json
